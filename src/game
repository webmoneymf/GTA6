 makeMap(){const c=$('mapCanvas'),ctx=c.getContext('2d');ctx.fillStyle='#203640';ctx.fillRect(0,0,320,320);ctx.strokeStyle='#6e7d7c';ctx.lineWidth=10;for(let i=0;i<8;i++){let p=20+i*40;ctx.beginPath();ctx.moveTo(p,0);ctx.lineTo(p,320);ctx.stroke();ctx.beginPath();ctx.moveTo(0,p);ctx.lineTo(320,p);ctx.stroke();}ctx.fillStyle='#e4d2a6';ctx.fillRect(240,0,80,320);ctx.fillStyle='#248ca0';ctx.fillRect(270,0,50,320);ctx.fillStyle='#ff7650';ctx.beginPath();ctx.arc(160,160,6,0,7);ctx.fill();ctx.fillStyle='#5de0cf';ctx.fillRect(200,95,8,8);}
 updateMap(){const c=$('mapCanvas'),ctx=c.getContext('2d');this.makeMap();let x=clamp(160+this.playerPos.x*.75,5,315),y=clamp(160+this.playerPos.z*.75,5,315);ctx.fillStyle='#fff';ctx.beginPath();ctx.arc(x,y,5,0,7);ctx.fill();ctx.fillStyle='#ff7547';ctx.beginPath();ctx.moveTo(clamp(160+this.target.x*.75,5,315),clamp(160+this.target.z*.75,5,315));ctx.lineTo(clamp(160+this.target.x*.75+7,5,315),clamp(160+this.target.z*.75+4,5,315));ctx.lineTo(clamp(160+this.target.x*.75+4,5,315),clamp(160+this.target.z*.75+9,5,315));ctx.fill();}
 resolvePlayerCollisions(){for(const r of this.collisionRects){const dx=this.playerPos.x-r.x,dz=this.playerPos.z-r.z;if(Math.abs(dx)<r.hw+.55&&Math.abs(dz)<r.hd+.55){const ox=r.hw+.55-Math.abs(dx),oz=r.hd+.55-Math.abs(dz);if(ox<oz)this.playerPos.x+=Math.sign(dx||1)*ox;else this.playerPos.z+=Math.sign(dz||1)*oz;}}}
 updatePolice(dt){if(!this.policeCar)return;const p=this.inCar?this.playerCar.position:this.playerPos;const d=this.policeCar.position.distanceTo(p);if(this.wanted>0){const dir=p.clone().sub(this.policeCar.position);dir.y=0;if(d>5){dir.normalize();this.policeCar.position.add(dir.multiplyScalar((5+this.wanted*1.4)*dt));this.policeCar.rotation.y=Math.atan2(-dir.x,-dir.z);this.policeCar.userData.wheels?.forEach(w=>w.rotation.x+=dt*8);}else if(performance.now()-this.lastDamage>1800){this.lastDamage=performance.now();this.health=Math.max(0,this.health-8);this.toast('ПОЛИЦИЯ ПРЕСЛЕДУЕТ ВАС');if(this.health===0){this.health=100;this.money=Math.max(0,this.money-250);this.playerPos.set(0,0,12);if(this.inCar){this.playerCar.position.set(8,0,20);this.carSpeed=0;}this.wanted=0;this.toast('ВЫ ВОССТАНОВИЛИСЬ В ГОРОДЕ');}}}else{this.policeCar.position.lerp(new THREE.Vector3(18,0,-70),Math.min(1,dt*.35));}}
 updateTraffic(dt){for(const c of this.traffic){c.position.x+=c.userData.direction*c.userData.cruise*dt;if(c.position.x>215)c.position.x=-215;if(c.position.x< -215)c.position.x=215;c.rotation.y=c.userData.direction>0?-Math.PI/2:Math.PI/2;c.userData.wheels?.forEach(w=>w.rotation.x+=c.userData.cruise*dt*1.3);}}
 animate(){requestAnimationFrame(()=>this.animate());const dt=Math.min(this.clock.getDelta(),.04);if(!this.paused)this.update(dt);this.renderer.render(this.scene,this.camera);}
 update(dt){
  this.day+=dt*.001;this.sun.position.x=Math.sin(this.day)*90-40;this.updateTraffic(dt);this.updatePolice(dt);this.updateWeather(dt);if(this.missionMarker){this.missionMarker.position.x=this.target.x;this.missionMarker.position.z=this.target.z;this.missionMarker.rotation.y+=dt*.6;}
  if(this.inCar){let accel=(this.keys.KeyW?1:0)-(this.keys.KeyS?1:0);this.carSpeed=clamp(this.carSpeed+accel*22*dt,-12,34);this.carSpeed*=Math.pow(this.keys.Space?.91:.985,dt*60);if(this.keys.KeyA)this.playerCar.rotation.y+=dt*1.7*(this.carSpeed>=0?1:-1);if(this.keys.KeyD)this.playerCar.rotation.y-=dt*1.7*(this.carSpeed>=0?1:-1);this.playerCar.translateZ(-this.carSpeed*dt);this.playerCar.userData.speed=this.carSpeed;this.playerCar.position.x=clamp(this.playerCar.position.x,-205,205);this.playerCar.position.z=clamp(this.playerCar.position.z,-205,205);
   for(const other of this.cars){if(other===this.playerCar)continue;const dist=other.position.distanceTo(this.playerCar.position);if(dist<3.1){this.carSpeed*=-.22;this.playerCar.position.add(new THREE.Vector3(0,0,1.2));this.toast('СТОЛКНОВЕНИЕ');}}
   this.playerCar.userData.wheels?.forEach(w=>w.rotation.x+=this.carSpeed*dt*1.6);this.playerPos.copy(this.playerCar.position);}
  else{let f=(this.keys.KeyW?1:0)-(this.keys.KeyS?1:0),s=(this.keys.KeyD?1:0)-(this.keys.KeyA?1:0);let speed=this.keys.ShiftLeft?10:5.3;let forward=new THREE.Vector3(-Math.sin(this.yaw),0,-Math.cos(this.yaw)),right=new THREE.Vector3(Math.cos(this.yaw),0,-Math.sin(this.yaw));let move=forward.multiplyScalar(f).add(right.multiplyScalar(s));if(move.length()>0){move.normalize().multiplyScalar(speed*dt);this.playerPos.add(move);this.active.rotation.y=this.yaw+Math.PI;this.active.userData.phase+=dt*speed;let p=this.active.userData.phase;this.active.userData.legL.rotation.x=Math.sin(p*1.7)*.55;this.active.userData.legR.rotation.x=-Math.sin(p*1.7)*.55;this.active.userData.armL.rotation.x=-Math.sin(p*1.7)*.35;this.active.userData.armR.rotation.x=Math.sin(p*1.7)*.35;}if(!this.onGround){this.playerPos.y+=this.jumpVelocity*dt;this.jumpVelocity-=19*dt;if(this.playerPos.y<=0){this.playerPos.y=0;this.jumpVelocity=0;this.onGround=true;}}
  this.resolvePlayerCollisions();this.playerPos.x=clamp(this.playerPos.x,-205,205);this.playerPos.z=clamp(this.playerPos.z,-205,205);this.active.position.copy(this.playerPos);this.active.position.y=this.playerPos.y;}
  for(const n of this.npcs){if(n.position.distanceTo(this.playerPos)<5)n.userData.walkDir=Math.atan2(n.position.x-this.playerPos.x,n.position.z-this.playerPos.z);else n.userData.walkDir+=Math.sin(this.day+n.position.x)*dt*.12;n.position.x+=Math.sin(n.userData.walkDir)*n.userData.speed*dt;n.position.z+=Math.cos(n.userData.walkDir)*n.userData.speed*dt;if(Math.abs(n.position.x)>105||Math.abs(n.position.z)>105)n.userData.walkDir+=Math.PI;n.rotation.y=n.userData.walkDir;}
  let focus=this.inCar?this.playerCar.position:this.playerPos;const dist=this.aiming?this.zoom*.62:this.zoom;const offset=new THREE.Vector3(Math.sin(this.yaw)*Math.cos(this.pitch)*dist,2.2+this.pitch*2.6,Math.cos(this.yaw)*Math.cos(this.pitch)*dist);const desired=focus.clone().add(offset);const camDir=desired.clone().sub(focus).normalize();const wallRay=new THREE.Raycaster(focus.clone().add(new THREE.Vector3(0,1.5,0)),camDir,0,dist);const wallHits=wallRay.intersectObjects(this.scene.children,true).filter(h=>h.distance>2&&h.object!==this.ground&&h.object.parent!==this.active&&h.object.parent!==this.playerCar&&h.object.isMesh);let camTarget=desired;if(wallHits.length)camTarget=focus.clone().add(camDir.multiplyScalar(Math.max(1.5,wallHits[0].distance-.5))).add(new THREE.Vector3(0,1.5,0));this.camera.position.lerp(camTarget,1-Math.pow(.001,dt));this.camera.lookAt(focus.x,focus.y+1.45,focus.z);this.camera.fov=THREE.MathUtils.lerp(this.camera.fov,this.aiming?48:62,Math.min(1,dt*7));this.camera.updateProjectionMatrix();
  const nearest=this.cars.filter(c=>!c.userData.traffic).reduce((best,c)=>c.position.distanceTo(this.playerPos)<best.distance?{car:c,distance:c.position.distanceTo(this.playerPos)}:best,{distance:999});$('prompt').textContent=this.inCar?'F — ВЫЙТИ ИЗ АВТОМОБИЛЯ':nearest.distance<6?'F — СЕСТЬ В АВТОМОБИЛЬ':this.playerPos.distanceTo(this.target)<18?'E — ВЫПОЛНИТЬ ЦЕЛЬ':'';this.updateHud();if(!$('mapPanel').classList.contains('hidden'))this.updateMap();
