 applySave(d){this.playerPos.set(d.x||0,0,d.z||12);this.money=d.money||2450;this.health=d.health||100;this.missionDone=!!d.missionDone;this.missionStage=d.missionStage||0;this.char=d.char||'JASON';this.active.visible=false;this.active=this.char==='LUCIA'?this.lucia:this.jason;this.active.visible=true;this.active.position.copy(this.playerPos);this.updateHud();}
 makeWeather(){const count=500,positions=new Float32Array(count*3);for(let i=0;i<count;i++){positions[i*3]=rnd(-110,110);positions[i*3+1]=rnd(5,45);positions[i*3+2]=rnd(-110,110);}const geo=new THREE.BufferGeometry();geo.setAttribute('position',new THREE.BufferAttribute(positions,3));const mat=new THREE.PointsMaterial({color:0xd7efff,size:.11,transparent:true,opacity:.0});this.rain=new THREE.Points(geo,mat);this.scene.add(this.rain);this.weatherMode=0;}
 toggleWeather(){this.weatherMode=(this.weatherMode+1)%3;if(this.weatherMode===0){this.rain.material.opacity=0;this.scene.fog.color.set(0x9bc8d8);this.scene.background.set(0x9bc8d8);this.toast('ЯСНО');}else if(this.weatherMode===1){this.rain.material.opacity=.45;this.scene.fog.color.set(0x8299a4);this.scene.background.set(0x8299a4);this.toast('НАЧАЛСЯ ДОЖДЬ');}else{this.rain.material.opacity=0;this.scene.fog.color.set(0xf1a57b);this.scene.background.set(0xf1a57b);this.toast('ЗАКАТ');}}
