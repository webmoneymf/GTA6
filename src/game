 save(){const data={x:this.playerPos.x,z:this.playerPos.z,char:this.char,money:this.money,health:this.health,missionDone:this.missionDone,missionStage:this.missionStage};const req=indexedDB.open('JasonLuciaSave',1);req.onupgradeneeded=()=>req.result.createObjectStore('save');req.onsuccess=()=>{const tx=req.result.transaction('save','readwrite');tx.objectStore('save').put(data,'slot1');tx.oncomplete=()=>this.toast('ИГРА СОХРАНЕНА');};req.onerror=()=>{localStorage.setItem('jl-save',JSON.stringify(data));this.toast('ИГРА СОХРАНЕНА');};}
