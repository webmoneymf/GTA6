 shoot(){const now=performance.now();if(now-this.lastShot<230)return;this.lastShot=now;if(this.ammo<=0){this.toast('НЕТ ПАТРОНОВ — НАЖМИТЕ R');return;}this.ammo--;const flash=new THREE.Mesh(new THREE.SphereGeometry(.09,8,6),new THREE.MeshBasicMaterial({color:0xffc36b}));flash.position.copy(this.active.position).add(new THREE.Vector3(.45,1.55,-.25));this.scene.add(flash);setTimeout(()=>this.scene.remove(flash),55);const dir=new THREE.Vector3();this.camera.getWorldDirection(dir);const origin=this.active.position.clone().add(new THREE.Vector3(0,1.7,0));const ray=new THREE.Raycaster(origin,dir,0,65);const hits=ray.intersectObjects(this.npcs,true);if(hits.length){let obj=hits[0].object;while(obj.parent&&!this.npcs.includes(obj))obj=obj.parent;if(this.npcs.includes(obj)){this.scene.remove(obj);this.npcs=this.npcs.filter(n=>n!==obj);this.wanted=Math.min(5,this.wanted+1);this.toast('ЦЕЛЬ ПОРАЖЕНА');}}this.updateHud();}
 reload(){if(this.reserve<=0||this.ammo>=12)return;let n=Math.min(12-this.ammo,this.reserve);this.ammo+=n;this.reserve-=n;this.updateHud();this.toast('ПЕРЕЗАРЯДКА');}
